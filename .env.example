# Next server -> Batch 1 API gateway. Restart Next after changing.
API_URL=http://localhost:8080
# Legacy NEXT_PUBLIC_API_URL remains supported; browsers use same-origin /api and /auth.
# SockJS reaches the gateway directly; Next HTTP rewrites do not proxy WebSockets.
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws
# Additional comma-separated HTTPS image hosts.
PRODUCT_IMAGE_HOSTS=
